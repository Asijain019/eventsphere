# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://eventsphere:eventsphere@localhost:5432/eventsphere"
# --- Auth: generate with `openssl rand -base64 32` ---
AUTH_SECRET="change-me-to-a-long-random-string"
# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_DEFAULT_CITY="jaipur"
# --- Uploads: "local" (public/uploads, dev only) or "blob" (Vercel Blob) ---
STORAGE_PROVIDER="local"
BLOB_READ_WRITE_TOKEN=""
# --- Optional Redis (rate limiting/cache). App works without it. ---
REDIS_URL=""
